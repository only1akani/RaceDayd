@model ResultsPageViewModel
@{
    ViewData["Title"] = "Results";
    ViewData["ActiveTab"] = "Results";
    EventNavModel nav = new EventNavModel { EventId = Model.Event.EventId, EventName = Model.Event.EventName };
    int captured = Model.Enrolments.Count(e => e.ResultId.HasValue);
}

<partial name="_EventNav" model="nav" />

@if (!Model.Finished)
{
    <div class="alert rd-alert rd-alert-danger mb-4">
        <i class="bi bi-hourglass-split me-2"></i>This event takes place on <strong>@Model.Event.EventDate.ToString("d MMMM yyyy")</strong>.
        Results can be entered once it has finished.
    </div>
}

@if (Model.Enrolments.Count == 0)
{
    <div class="rd-card p-5 text-center">
        <div class="rd-feature-icon mx-auto"><i class="bi bi-trophy"></i></div>
        <h3>Nobody has entered this event</h3>
        <p class="text-muted mb-0">There are no participants to capture results for.</p>
    </div>
}
else
{
    <p class="text-muted">
        <strong>@captured</strong> of <strong>@Model.Enrolments.Count</strong> results captured.
        Enter each finish time as hours:minutes:seconds, for example <strong>00:48:32</strong>.
        Results are published on the event page as soon as you save them.
    </p>

    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table mb-0 align-middle">
                <thead>
                    <tr><th>Participant</th><th>Category</th><th>Status</th><th class="text-end">Result</th></tr>
                </thead>
                <tbody>
                    @foreach (EventEnrolment e in Model.Enrolments)
                    {
                        <tr>
                            <td class="fw-bold">@e.ParticipantName</td>
                            <td>@e.CategoryName</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td class="text-end">
                                @if (e.ResultId.HasValue)
                                {
                                    <span class="rd-time" style="font-size: 1.5rem;">@UiHelpers.FormatTime(e.FinishTime)</span>
                                    <span class="ms-2 fw-bold">@(e.Position.HasValue? UiHelpers.Ordinal(e.Position.Value) : "-")</span>
                                    <i class="bi bi-check-circle-fill ms-2" style="color: var(--rd-green);" title="Saved and published"></i>
                                }
                                else
                                {
                                    <form asp-action="Save" method="post" class="d-flex gap-2 justify-content-end flex-wrap">
                                        <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                        <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                        <fieldset disabled="@(!Model.Finished)" class="d-flex gap-2 flex-wrap justify-content-end border-0 p-0 m-0">
                                            <input name="finishTime" class="form-control form-control-sm" style="width: 110px;" placeholder="00:48:32"
                                                   pattern="\d{2}:[0-5]\d:[0-5]\d" title="Use hh:mm:ss, for example 00:48:32" required />
                                            <input name="position" type="number" min="1" class="form-control form-control-sm" style="width: 90px;" placeholder="Position" required />
                                            <button type="submit" class="btn btn-sm btn-primary">Save result</button>
                                        </fieldset>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}