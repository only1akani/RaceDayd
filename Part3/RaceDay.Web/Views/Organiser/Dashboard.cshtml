@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="rd-page-title mb-0">Organiser dashboard</h1>
    <a asp-controller="ManageEvents" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Create event</a>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert rd-alert rd-alert-danger">@Model.ErrorMessage</div>
}
else if (Model.TotalEvents == 0)
{
    <div class="rd-card p-5 text-center">
        <div class="rd-feature-icon mx-auto"><i class="bi bi-flag"></i></div>
        <h3>Welcome to RaceDay</h3>
        <p class="text-muted">You have not created any events yet. Create your first event to start taking entries.</p>
        <a asp-controller="ManageEvents" asp-action="Create" class="btn btn-primary">Create my first event</a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="rd-card rd-stat">
                <div class="rd-stat-number">@Model.TotalEvents</div>
                <div class="rd-stat-label">Events created</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="rd-card rd-stat">
                <div class="rd-stat-number">@Model.Upcoming.Count</div>
                <div class="rd-stat-label">Upcoming events</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="rd-card rd-stat">
                <div class="rd-stat-number">@Model.TotalEnrolments</div>
                <div class="rd-stat-label">Total enrolments</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="rd-card rd-stat">
                <div class="rd-stat-number">@Model.PendingEnrolments</div>
                <div class="rd-stat-label">Awaiting confirmation</div>
            </div>
        </div>
    </div>

    <h2 class="rd-page-title">Upcoming events</h2>
    @if (Model.Upcoming.Count == 0)
    {
        <div class="rd-card p-4 text-muted mb-4">You have no upcoming events. Create one to get entries coming in.</div>
    }
    else
    {
        <div class="rd-card mb-4">
            <div class="table-responsive">
                <table class="table rd-table mb-0 align-middle">
                    <thead>
                        <tr><th>Date</th><th>Event</th><th>Enrolments</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (OrganiserEvent item in Model.Upcoming)
                        {
                            int days = (item.EventDate.Date - DateTime.Today).Days;
                            <tr>
                                <td>
                                    <strong>@item.EventDate.ToString("d MMM yyyy")</strong>
                                    <div class="small text-muted">@(days <= 0 ? "Today" : days == 1 ? "Tomorrow" : "In " + days + " days")</div>
                                </td>
                                <td>
                                    <span class="fw-bold">@item.EventName</span>
                                    <div class="small"><span class="rd-type-tag">@item.EventType</span> <span class="text-muted">@item.Location</span></div>
                                </td>
                                <td>@item.EnrolmentCount entered, @item.ConfirmedCount confirmed</td>
                                <td class="text-end">
                                    <a asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@item.EventId" class="btn btn-sm btn-navy">View enrolments</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <h2 class="rd-page-title">All my events</h2>
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table mb-0 align-middle">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Categories</th><th>Total enrolments</th><th>Results entered</th></tr>
                </thead>
                <tbody>
                    @foreach (OrganiserEvent item in Model.Events)
                    {
                        <tr>
                            <td><a asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@item.EventId" class="fw-bold text-decoration-none">@item.EventName</a></td>
                            <td>
                                @item.EventDate.ToString("d MMM yyyy")
                                @if (item.EventDate < DateTime.Now)
                                {
                                    <span class="rd-type-tag ms-1" style="background: var(--rd-muted);">Finished</span>
                                }
                            </td>
                            <td>@item.CategoryCount</td>
                            <td><strong>@item.EnrolmentCount</strong></td>
                            <td>@item.ResultCount of @item.EnrolmentCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}