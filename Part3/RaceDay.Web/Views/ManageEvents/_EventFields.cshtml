@model EventFormViewModel

<div asp-validation-summary="ModelOnly" class="alert rd-alert rd-alert-danger"></div>

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="EventName" class="form-label"></label>
        <input asp-for="EventName" class="form-control" />
        <span asp-validation-for="EventName" class="field-validation-error"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType" class="field-validation-error"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="EventDescription" class="form-label"></label>
    <textarea asp-for="EventDescription" class="form-control" rows="3"></textarea>
    <span asp-validation-for="EventDescription" class="field-validation-error"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" />
        <span asp-validation-for="EventDate" class="field-validation-error"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="field-validation-error"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Distance" class="form-label"></label>
        <input asp-for="Distance" type="number" step="0.01" min="0.1" class="form-control" />
        <span asp-validation-for="Distance" class="field-validation-error"></span>
    </div>
</div>

<div class="mb-3">
    <label class="form-label" for="banner">Event banner image</label>
    @if (!string.IsNullOrWhiteSpace(Model.BannerUrl))
    {
        <div class="mb-2">
            <img src="@Model.BannerUrl" alt="Current banner" class="rd-edit-banner" />
            <div class="form-text">Choose a new image below to replace this banner.</div>
        </div>
    }
    <input id="banner" name="banner" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
    <div class="form-text">JPG, PNG or WEBP, up to 5 MB. It is shown on the event page.</div>
</div>