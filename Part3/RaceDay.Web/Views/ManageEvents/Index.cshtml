@model List<OrganiserEvent>
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="rd-page-title mb-0">My Events</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-card p-5 text-center">
        <div class="rd-feature-icon mx-auto"><i class="bi bi-flag"></i></div>
        <h3>No events yet</h3>
        <p class="text-muted">Create your first event, add some categories, and participants can start entering.</p>
        <a asp-action="Create" class="btn btn-primary">Create an event</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table mb-0 align-middle">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Categories</th><th>Enrolments</th><th class="text-end">Manage</th></tr>
                </thead>
                <tbody>
                    @foreach (OrganiserEvent item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(item.BannerUrl))
                                    {
                                        <img src="@item.BannerUrl" alt="" class="rd-thumb" />
                                    }
                                    else
                                    {
                                        <div class="rd-thumb rd-thumb-placeholder"><i class="bi @UiHelpers.EventIcon(item.EventType)"></i></div>
                                    }
                                    <div>
                                        <div class="fw-bold">@item.EventName</div>
                                        <div class="small text-muted">
                                            <span class="rd-type-tag">@item.EventType</span>
                                            @item.Location
                                            @if (item.Distance > 0)
                                            {
                                                <span> &middot; @item.Distance.ToString("0.##") km</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @item.EventDate.ToString("d MMM yyyy")
                                @if (item.EventDate < DateTime.Now)
                                {
                                    <div class="small text-muted">Finished</div>
                                }
                            </td>
                            <td>@item.CategoryCount</td>
                            <td>@item.ConfirmedCount confirmed of @item.EnrolmentCount</td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@item.EventId" class="btn btn-sm btn-outline-primary">Categories</a>
                                <a asp-controller="ManageEnrolments" asp-action="Index" asp-route-eventId="@item.EventId" class="btn btn-sm btn-outline-primary">Enrolments</a>
                                <a asp-controller="ManageResults" asp-action="Index" asp-route-eventId="@item.EventId" class="btn btn-sm btn-outline-primary">Results</a>
                                <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-navy">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.EventId" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event, its categories and all its enrolments? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}