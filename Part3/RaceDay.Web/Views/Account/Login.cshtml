@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="rd-card p-4 p-md-5">
            <h1 class="rd-page-title">Log in</h1>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert rd-alert rd-alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-lg">Log in</button>
            </form>

            <p class="text-muted text-center mt-4 mb-0">
                New to RaceDay? <a asp-action="Register">Create an account</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}