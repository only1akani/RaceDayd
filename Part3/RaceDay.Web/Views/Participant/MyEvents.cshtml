@model List<MyEnrolment>
@{
    ViewData["Title"] = "My Events";
}

<h1 class="rd-page-title">My Events</h1>

@if (Model.Count == 0)
{
    <div class="rd-card p-5 text-center">
        <div class="rd-feature-icon mx-auto"><i class="bi bi-calendar-event"></i></div>
        <h3>You have not entered any events yet</h3>
        <p class="text-muted">Find a race you like and enter in a click.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse events</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MyEnrolment item in Model)
                    {
                        bool past = item.EventDate < DateTime.Now;
                        <tr>
                            <td>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId" class="fw-bold text-decoration-none">@item.EventName</a>
                                <div class="small text-muted"><span class="rd-type-tag">@item.EventType</span> @item.Location</div>
                            </td>
                            <td>
                                @item.EventDate.ToString("d MMM yyyy")
                                @if (past)
                                {
                                    <div class="small text-muted">Past event</div>
                                }
                            </td>
                            <td>@item.CategoryName</td>
                            <td>@(item.Price > 0 ? "R " + item.Price.ToString("0.00") : "Free")</td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                            <td class="text-end">
                                @if (!past)
                                {
                                    <form asp-action="Cancel" asp-route-id="@item.EnrolmentId" method="post"
                                          onsubmit="return confirm('Cancel your enrolment in @item.EventName?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}