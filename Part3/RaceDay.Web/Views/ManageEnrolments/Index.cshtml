@model EnrolmentsPageViewModel
@{
    ViewData["Title"] = "Enrolments";
    ViewData["ActiveTab"] = "Enrolments";
    EventNavModel nav = new EventNavModel { EventId = Model.Event.EventId, EventName = Model.Event.EventName };
    int confirmed = Model.Enrolments.Count(e => e.Status == "Confirmed");
    int pending = Model.Enrolments.Count - confirmed;
}

<partial name="_EventNav" model="nav" />

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="rd-card rd-stat">
            <div class="rd-stat-number">@Model.Enrolments.Count</div>
            <div class="rd-stat-label">Participants entered</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rd-card rd-stat" style="border-left-color: var(--rd-green);">
            <div class="rd-stat-number">@confirmed</div>
            <div class="rd-stat-label">Confirmed</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rd-card rd-stat" style="border-left-color: var(--rd-amber);">
            <div class="rd-stat-number">@pending</div>
            <div class="rd-stat-label">Pending</div>
        </div>
    </div>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="rd-card p-5 text-center">
        <div class="rd-feature-icon mx-auto"><i class="bi bi-people"></i></div>
        <h3>No enrolments yet</h3>
        <p class="text-muted mb-0">When participants enter this event, they will appear here.</p>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table mb-0 align-middle">
                <thead>
                    <tr><th>Participant</th><th>Category</th><th>Entered on</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (EventEnrolment e in Model.Enrolments)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@e.ParticipantName</div>
                                <div class="small text-muted">@e.ParticipantEmail</div>
                            </td>
                            <td>@e.CategoryName</td>
                            <td>@e.EnrolmentDate.ToString("d MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td class="text-end">
                                <form asp-action="SetStatus" method="post" class="d-inline">
                                    <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                    <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                    @if (e.Status == "Confirmed")
                                    {
                                        <input type="hidden" name="status" value="Pending" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Mark as pending</button>
                                    }
                                    else
                                    {
                                        <input type="hidden" name="status" value="Confirmed" />
                                        <button type="submit" class="btn btn-sm btn-primary">Confirm</button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}