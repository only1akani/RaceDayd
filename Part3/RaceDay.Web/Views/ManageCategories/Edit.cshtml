@model CategoriesPageViewModel
@{
    ViewData["Title"] = "Edit category";
    ViewData["ActiveTab"] = "Categories";
    EventNavModel nav = new EventNavModel { EventId = Model.Event.EventId, EventName = Model.Event.EventName };
}

<partial name="_EventNav" model="nav" />

<div class="rd-card p-4 p-md-5" style="max-width: 640px;">
    <h2 class="h3 mb-4">Edit category</h2>

    <form asp-action="Edit" method="post">
        <partial name="_CategoryFields" model="Model" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" asp-route-eventId="@Model.Event.EventId" class="btn btn-outline-primary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}