@{
    string? role = Context.Session.GetString("Role");
    string? fullName = Context.Session.GetString("FullName");
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    //marks a menu link as active when we are on one of its pages
    string Active(params string[] names)
    {
        return names.Any(n => n.Equals(controller, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index"><span class="rd-logo-mark">&raquo;</span>RACE<span>DAY</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">

                    @if (role == "Organiser")
                    {
                        <!-- Organiser menu -->
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("ManageEvents", "ManageCategories", "ManageEnrolments", "ManageResults")" asp-controller="ManageEvents" asp-action="Index">My Events</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav align-items-lg-center">
                            <li class="nav-item">
                                <a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">@fullName</a>
                            </li>
                            <li class="nav-item"><span class="rd-role-pill rd-role-organiser">Organiser</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light ms-lg-3">Log out</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else if (role == "Participant")
                    {
                        <!-- Participant menu -->
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index">Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Participant")" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Results")" asp-controller="Results" asp-action="MyResults">My Results</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav align-items-lg-center">
                            <li class="nav-item">
                                <a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">@fullName</a>
                            </li>
                            <li class="nav-item"><span class="rd-role-pill rd-role-participant">Participant</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light ms-lg-3">Log out</button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Guest menu -->
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index">Events</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav align-items-lg-center">
                            <li class="nav-item">
                                <a class="nav-link @Active("Account")" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-lg-3" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <div class="container py-4">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between">
            <span><strong>RACEDAY</strong> &middot; Run it. Walk it. Ride it.</span>
            <span>&copy; @DateTime.Now.Year RaceDay</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>