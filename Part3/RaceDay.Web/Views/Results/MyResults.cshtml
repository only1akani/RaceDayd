@model MyResultsViewModel
@{
    ViewData["Title"] = "My Results";
    int podiums = Model.Results.Count(r => r.Position.HasValue && r.Position.Value <= 3);
    int? best = Model.Results.Where(r => r.Position.HasValue).Select(r => (int?)r.Position!.Value).DefaultIfEmpty(null).Min();
}

<h1 class="rd-page-title">My Results</h1>

@if (Model.Results.Count == 0 && Model.AwaitingResults.Count == 0)
{
    <div class="rd-card p-5 text-center">
        <div class="rd-feature-icon mx-auto"><i class="bi bi-trophy"></i></div>
        <h3>No results yet</h3>
        <p class="text-muted">Once you have finished a race and the organiser has captured the results, your race history will appear here.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Find an event</a>
    </div>
}
else
{
    @if (Model.Results.Count > 0)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="rd-card rd-stat">
                    <div class="rd-stat-number">@Model.Results.Count</div>
                    <div class="rd-stat-label">Races finished</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="rd-card rd-stat">
                    <div class="rd-stat-number">@podiums</div>
                    <div class="rd-stat-label">Podium finishes</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="rd-card rd-stat">
                    <div class="rd-stat-number">@(best.HasValue ? UiHelpers.Ordinal(best.Value) : "-")</div>
                    <div class="rd-stat-label">Best position</div>
                </div>
            </div>
        </div>

        @foreach (MyResult r in Model.Results)
        {
            string medal = r.Position.HasValue && r.Position.Value <= 3 ? "rd-medal-" + r.Position.Value : "";

            <div class="rd-card rd-category-row mb-3">
                <div class="row align-items-center g-3">
                    <div class="col-auto">
                        <div class="rd-medal @medal">@(r.Position.HasValue ? r.Position.Value.ToString() : "-")</div>
                    </div>
                    <div class="col-md">
                        <h3 class="h4 mb-1">
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId" class="text-decoration-none">@r.EventName</a>
                        </h3>
                        <div class="text-muted">
                            <span class="rd-type-tag me-1">@r.EventType</span>
                            @r.EventDate.ToString("d MMM yyyy")
                            @if (!string.IsNullOrWhiteSpace(r.Location))
                            {
                                <span> &middot; @r.Location</span>
                            }
                            <span> &middot; @r.CategoryName</span>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="rd-time">@UiHelpers.FormatTime(r.FinishTime)</div>
                        <div class="text-muted">
                            @if (r.Position.HasValue)
                            {
                                <strong>@UiHelpers.Ordinal(r.Position.Value)</strong> <span>of @r.TotalFinishers finishers</span>
                            }
                            else
                            {
                                <span>Position not recorded</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @if (Model.AwaitingResults.Count > 0)
    {
        <h2 class="rd-page-title mt-4">Awaiting results</h2>
        <div class="rd-card">
            <div class="table-responsive">
                <table class="table rd-table mb-0 align-middle">
                    <thead>
                        <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (MyEnrolment e in Model.AwaitingResults)
                        {
                            <tr>
                                <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-bold text-decoration-none">@e.EventName</a></td>
                                <td>@e.EventDate.ToString("d MMM yyyy")</td>
                                <td>@e.CategoryName</td>
                                <td><partial name="_StatusBadge" model="e.Status" /> <span class="small text-muted ms-1">Results not captured yet</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}